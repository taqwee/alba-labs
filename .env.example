# =====================================================================
# Lunomi Studio — environment variables
# Copy to .env.local for local work. On Netlify/Render add the same
# names in the dashboard. NEVER commit real values.
#
# PUBLIC       = safe for the browser (bundled into client code)
# SERVER ONLY  = must never be exposed; never prefix with NEXT_PUBLIC_
# =====================================================================

# --- Supabase (required) ---------------------------------------------
# PUBLIC
NEXT_PUBLIC_SUPABASE_URL=
# PUBLIC (anon key is designed to be public; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ1and3bXZ0ZnpqZGpiZmdmdWF1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3Njc4MjksImV4cCI6MjEwNjM0MzgyOX0.6cNtRbp7IKEOsSwePH1DZH6os9XVoVaTUC5_cMrW85w
# SERVER ONLY — bypasses RLS. Used for webhooks, staff invites, file access.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ1and3bXZ0ZnpqZGpiZmdmdWF1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDc2NzgyOSwiZXhwIjoyMTA2MzQzODI5fQ.BwOnVvLfBNiMRcHMfbQL-xbsz8TK9UeoK9pF6Lw6bnA

# --- Site (required in production) -----------------------------------
# PUBLIC — full origin, no trailing slash. Change this when you move to
# your custom domain, e.g. https://lunomistudio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp (optional — the app works fine without these) ----------
# off  = WhatsApp disabled (default when credentials are missing)
# mock = simulated WhatsApp, nothing ever leaves the server
# live = official Meta WhatsApp Cloud API
# (leave empty to auto-select: live if all credentials exist, else off)
WHATSAPP_MODE=
# SERVER ONLY
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# SERVER ONLY — any random string you choose; paste the same value in Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=
# SERVER ONLY — from Meta App Dashboard > App settings > Basic
META_APP_SECRET=
# SERVER ONLY (optional) — approved template used to re-open a chat after 24h
WHATSAPP_REENGAGEMENT_TEMPLATE=
WHATSAPP_REENGAGEMENT_TEMPLATE_LANG=en
# SERVER ONLY (optional) — Graph API version
WHATSAPP_API_VERSION=v21.0
